# CRI local/deployment configuration template. Copy to .env locally and replace
# every placeholder with an independently generated secret. Never commit .env.

# Required API authentication and human approval signing keys (>= 32 random bytes each).
CRI_ADMIN_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN_AT_LEAST_32_BYTES
CRI_APPROVAL_SECRET=REPLACE_WITH_INDEPENDENT_APPROVAL_SECRET_AT_LEAST_32_BYTES

# Persistent application data. Railway requires a mounted persistent volume for these files.
CRI_DATA_DIR=/data
CRI_AUDIT_FILE=/data/audit.jsonl
CRI_KILL_FILE=/data/KILL
CRI_NONCE_DB=/data/approval_nonces.sqlite3

# PostgreSQL. Migration URL must be a schema-owner/admin connection and is removed
# from the process environment after startup migrations. Runtime URL must use cri_app.
CRI_MIGRATION_DATABASE_URL=postgresql://OWNER:OWNER_PASSWORD@HOST:5432/DBNAME
CRI_DATABASE_URL=postgresql+psycopg://cri_app:APP_PASSWORD@HOST:5432/DBNAME
CRI_APP_PASSWORD=REPLACE_WITH_INDEPENDENT_RUNTIME_DB_PASSWORD
# DATABASE_URL is accepted as a fallback for CRI_DATABASE_URL.

# Redis: optional but required for shared cache/queue/heartbeat state.
CRI_REDIS_URL=redis://:REDIS_PASSWORD@HOST:6379/0
# REDIS_URL is accepted as a fallback for CRI_REDIS_URL.

# OPA: optional; if configured, startup and authorization fail closed when unavailable.
CRI_OPA_URL=http://opa:8181
# OPA_URL is accepted as a fallback for CRI_OPA_URL.

# Remote append-only audit receiver. Receiver must enforce WORM/Object Lock itself.
CRI_AUDIT_REMOTE_URL=https://AUDIT_RECEIVER_HOST/events
CRI_AUDIT_REMOTE_TOKEN=REPLACE_WITH_AUDIT_RECEIVER_TOKEN_AT_LEAST_32_BYTES
# Alternative: S3 Object Lock bucket (COMPLIANCE mode); provision bucket Object Lock first.
CRI_AUDIT_S3_BUCKET=
CRI_AUDIT_S3_RETENTION_DAYS=365
AWS_REGION=
# AUDIT_WORM_URL and AUDIT_WORM_TOKEN are accepted aliases.

# Universal LLM Gateway. Disabled by default; enable only after reviewing provider policy.
LLM_ENABLED=false
# Supported providers: openrouter, openai-compatible, gemini, anthropic.
# Fallback is optional; if any fallback setting is supplied, provider/base URL/model
# must all be supplied. Fallback key defaults to primary key.
CRI_LLM_PROVIDER=openrouter
CRI_LLM_BASE_URL=https://openrouter.ai/api/v1
CRI_LLM_API_KEY=REPLACE_WITH_PROVIDER_KEY
CRI_LLM_MODEL=provider/model-name
CRI_LLM_FALLBACK_PROVIDER=gemini
CRI_LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
CRI_LLM_FALLBACK_MODEL=gemini-model-name
CRI_LLM_FALLBACK_API_KEY=REPLACE_WITH_FALLBACK_KEY
CRI_LLM_MAX_TOKENS=4096
CRI_LLM_TIMEOUT=60
CRI_LLM_RETRIES=2
CRI_LLM_MAX_COST_USD=5.00
# Set real per-million-token prices from provider pricing; zero means cost cannot be estimated.
CRI_LLM_INPUT_COST_PER_MILLION=0
CRI_LLM_OUTPUT_COST_PER_MILLION=0
# Legacy CRI_LLM_BASE_URL / API_KEY / MODEL remain supported by Developer.

# Sandbox: must be an operator-approved immutable image reference with sha256 digest.
# The API container must not receive Docker socket access. Missing/unavailable sandbox fails closed.
CRI_SANDBOX_IMAGE=REGISTRY/CRI-SANDBOX@sha256:REPLACE_WITH_64_HEX_DIGEST

# Dashboard build-time API base; leave empty when served through same-origin Nginx proxy.
VITE_API_BASE=

# Compose-only local/test service credentials; use independent random values.
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_OWNER_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
PORT=8000

# Data-driven quota enforcement. Set false only for an approved maintenance window.
QUOTA_ENABLED=true
OWNER_BYPASS_QUOTA=true
CRI_OWNER_USER_ID=human-admin

# Operational alerting (configure at least one channel).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_CPU_PERCENT=90
ALERT_MEMORY_PERCENT=90
ALERT_DISK_PERCENT=90

# Local-only placeholders. Replace with independent random values; never commit .env.
CRI_ADMIN_TOKEN=replace-with-random-admin-token-at-least-32-bytes
CRI_APPROVAL_SECRET=replace-with-independent-random-approval-secret-at-least-32-bytes
CRI_DATA_DIR=/data
CRI_AUDIT_FILE=/data/audit.jsonl
CRI_KILL_FILE=/data/KILL
CRI_NONCE_DB=/data/approval_nonces.sqlite3

# Used only by docker-compose.test.yml / GitHub Actions test services.
POSTGRES_PASSWORD=replace-with-random-postgres-test-password
REDIS_PASSWORD=replace-with-random-redis-test-password

# Reserved for a future JWT implementation; not consumed by current backend.
# JWT_SECRET=replace-with-independent-random-jwt-secret
